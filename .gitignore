# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
dist/
/.pnp
.pnp.*
.yarn/*
! .yarn/patches
! .yarn/plugins
! .yarn/releases
! .yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc & secrets
.DS_Store
*.pem
*.key
id_rsa*
secrets.*
*.log
*.sqlite
*.sql

# python & virtualenvs
.venv/
venv/
__pycache__/

# backups (respaldos locales con marca temporal)
*.bak
*.bak-*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (strict ignore except example template)
.env
.env.*
.env.local
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI context & clean root policy
.agentignore
PLAN_MAESTRO.md
AI_CONTEXT.md
INFORME_AUDITORIA_QA.md
prompt*.txt
chat_history.*
scratch/
CONTEXTO_PROYECTO.md
AGENTS.md
CLAUDE.md
.skills/
.claude/
.gemini/
.codex/
.superpowers/
.system_generated/
